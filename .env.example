# ===========================================================================
# Open Jarvis Android / Cloud-First Environment Configuration
# ===========================================================================

# ---------------------------------------------------------------------------
# 1. Cloud AI Engine Credentials
# ---------------------------------------------------------------------------
# Google Gemini API Key (from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter API Key (from https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Standard OpenAI API Key (optional)
OPENAI_API_KEY=

# Custom OpenAI-Compatible Base URL (e.g., https://openrouter.ai/api/v1 or local proxy)
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Default Model ID (e.g., gemini-2.5-flash, gemini-2.5-pro, openrouter/auto, etc.)
DEFAULT_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# 2. Speech & Audio Settings (Termux / Android)
# ---------------------------------------------------------------------------
# STT Backend: "gemini" (zero-extra-key multimodal audio transcription), "openai", or "auto"
JARVIS_SPEECH_BACKEND=gemini

# TTS Backend: "android_tts" (native Termux:API speech engine), "openai_tts", or "auto"
JARVIS_TTS_BACKEND=android_tts

# Speech Language (ISO-639-1 code e.g. "en", "fa", or empty for auto-detect)
JARVIS_SPEECH_LANGUAGE=en

# ---------------------------------------------------------------------------
# 3. Android / Termux Integration
# ---------------------------------------------------------------------------
# Subprocess timeout in seconds for Termux:API commands
TERMUX_API_TIMEOUT=8
